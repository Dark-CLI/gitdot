<?xml version="1.0" encoding="utf-8"?>
<zone>
  <short>Public</short>
  <description>Restrictive zone for external interface. Only Cloudflare tunnel and LAN gateway access.</description>

  <!-- Interface binding -->
  <interface name="enp9s0"/>

  <!-- Cloudflare tunnel (already handled via routing) -->

  <!-- Required for network functionality -->
  <service name="dhcpv6-client"/>

  <!-- Enable forwarding for tunnel and masquerade for outbound -->
  <forward/>
  <masquerade/>

  <!-- Allow traffic from this zone to docker services -->
  <rule family="ipv4">
    <destination address="10.0.0.0/24"/>
    <accept/>
  </rule>

  <!-- Allow HTTP/HTTPS from LAN gateway to services -->
  <rule family="ipv4">
    <source address="10.95.12.95"/>
    <destination address="10.0.0.0/24"/>
    <port protocol="tcp" port="80"/>
    <accept/>
  </rule>

  <rule family="ipv4">
    <source address="10.95.12.95"/>
    <destination address="10.0.0.0/24"/>
    <port protocol="tcp" port="443"/>
    <accept/>
  </rule>

  <!-- Allow DNS from LAN gateway to dnsmasq -->
  <rule family="ipv4">
    <source address="10.95.12.95"/>
    <destination address="10.0.0.254"/>
    <port protocol="udp" port="53"/>
    <accept/>
  </rule>

  <!-- Allow SSH and Mosh from specific LAN host -->
  <rule family="ipv4">
    <source address="10.95.12.95"/>
    <port protocol="tcp" port="22"/>
    <accept/>
  </rule>

  <rule family="ipv4">
    <source address="10.95.12.95"/>
    <port protocol="udp" port="60000-61000"/>
    <accept/>
  </rule>

  <!-- Stealth mode - silently drop ping requests -->
  <!-- TEMPORARILY DISABLED FOR TESTING -->
  <!--
  <rule>
    <icmp-type name="echo-request"/>
    <drop/>
  </rule>
  -->

</zone>
